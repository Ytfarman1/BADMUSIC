#!/bin/bash

# ====== 🎵 BADMUSIC STARTUP SCRIPT ======
# Colors (for fun 😎)
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN} 🚀 Starting BADMUSIC Bot...${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# Check Node installation
if ! command -v node &> /dev/null
then
    echo -e "${YELLOW}⚠️ Node.js not found! Installing Node.js 18.x...${NC}"
    curl -fsSL https://deb.nodesource.com/setup_18.x | bash -
    apt-get install -y nodejs
fi

# Show Node & Python versions
echo -e "${GREEN}✅ Node version: $(node -v)${NC}"
echo -e "${GREEN}✅ Python version: $(python3 -V)${NC}"

# Start the bot
echo -e "${CYAN}🎧 Launching BADMUSIC main module...${NC}"
python3 -m BADMUSIC

# Exit message
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✅ BADMUSIC Bot stopped successfully!${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
